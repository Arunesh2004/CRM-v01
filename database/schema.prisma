generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  DELETED
  PENDING
}

enum OnboardingStatus {
  PENDING
  COMPLETED
}

enum RpoPolicy {
  BASIC
  BUSINESS
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum ActorType {
  USER
  SYSTEM
  AI
  AUTOMATION
}

enum IntegrationProvider {
  WHATSAPP
  EMAIL
  TELEPHONY
  STORAGE
  INTERNAL_CHAT
  VIDEO
}

enum Resource {
  INCIDENT
  CUSTOMER
  CAMERA
  USER
  SYSTEM
  LEAD
  TASK
  LOCATION
  COMMUNICATION
  STREAM
  RECORDING
  AI_EVENT
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum Action {
  CREATE
  READ
  UPDATE
  DELETE
  RESOLVE
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model Tenant {
  id             String       @id @default(uuid())
  name           String
  ownerId        String?      @unique
  owner          User?        @relation("TenantOwner", fields: [ownerId], references: [id])
  status         TenantStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  rpoPolicy      RpoPolicy    @default(BASIC)

  tenantBootstrap    TenantBootstrap?
  departments        Department[]
  users              User[]
  roles              Role[]
  deviceSessions     DeviceSession[]
  auditLogs          AuditLog[]
  tenantIntegrations TenantIntegration[]
  leads              Lead[]
  customers          Customer[]
  customerContacts   CustomerContact[]
  locations          Location[]
  tasks              Task[]
  activityTimelines  ActivityTimeline[]

  // Communication
  meetings                Meeting[]
  meetingParticipants     MeetingParticipant[]
  demoStorageFiles        DemoStorage[]
  documents               Document[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  chatConversations        ChatConversation[]
  chatParticipants         ChatParticipant[]
  chatMessages             ChatMessage[]
  chatReadReceipts         ChatReadReceipt[]
  mailThreads              MailThread[]
  mailRecipients           MailRecipient[]
  mailMessages             MailMessage[]
  mailDrafts               MailDraft[]
  communicationAttachments CommunicationAttachment[]
  callLogs                 CallLog[]

  // CCTV
  cameras           Camera[]
  cameraCredentials CameraCredential[]
  cameraStreams     CameraStream[]
  recordings        Recording[]
  cameraEvents      CameraEvent[]
  aiEvents          AIEvent[]
  incidents         Incident[]
  webhookEvents     WebhookEvent[]

  // DR Lock
  isRestoreLocked        Boolean                 @default(false)
  crmComments            CRMComment[]
  pipelines              Pipeline[]
  pipelineStages         PipelineStage[]
  deals                  Deal[]
  dealStageHistories     DealStageHistory[]
  eventOutboxes          EventOutbox[]
  aiConversations        AIConversation[]
  aiConversationMessages AIConversationMessage[]
  userPresences          UserPresence[]
}

model TenantBootstrap {
  tenantId       String   @id
  bootstrappedAt DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Department {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id               String           @id @default(uuid())
  clerkId          String?
  email            String
  employeeId       String?
  firstName        String?
  lastName         String?
  phone            String?
  designation      String?
  profilePhotoUrl  String?
  tenantId         String
  departmentId     String?
  status           UserStatus       @default(INVITED)
  onboardingStatus OnboardingStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  ownedTenant       Tenant?            @relation("TenantOwner")
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userRoles         UserRole[]
  deviceSessions    DeviceSession[]
  assignedLeads     Lead[]
  assignedCustomers Customer[]
  assignedTasks     Task[]
  activities        ActivityTimeline[]
  deals             Deal[]             @relation("DealAssignedUser")
  createdDeals      Deal[]             @relation("DealCreatedUser")

  // Communication
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  chatParticipants         ChatParticipant[]
  sentChatMessages         ChatMessage[]
  chatReadReceipts         ChatReadReceipt[]
  mailRecipients           MailRecipient[]
  sentMailMessages         MailMessage[]
  mailDrafts               MailDraft[]
  communicationAttachments CommunicationAttachment[]
  userPresences            UserPresence[]

  incidents           Incident[]
  deletedAt           DateTime?
  crmComments         CRMComment[]
  dealStageHistories  DealStageHistory[]
  meetingParticipants MeetingParticipant[]
  aiConversations     AIConversation[]
  uploadedDocuments   Document[]

  @@unique([tenantId, email])
  @@unique([tenantId, employeeId])
  @@unique([tenantId, clerkId])
  @@index([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, departmentId])
}

model DeviceSession {
  id         String   @id @default(uuid())
  userId     String
  tenantId   String
  deviceInfo String
  ipAddress  String
  isActive   Boolean  @default(true)
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model Role {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  userRoles   UserRole[]
  permissions RolePermission[]
  deletedAt   DateTime?

  @@index([tenantId, id])
}

model Permission {
  id        String   @id @default(uuid())
  resource  Resource
  action    Action
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
}

model AuditLog {
  id         String    @id @default(uuid())
  tenantId   String
  actorId    String
  actorType  ActorType
  action     String
  resource   String
  resourceId String
  metadata   Json?
  ipAddress  String?
  timestamp  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, timestamp])
  @@index([tenantId, actorId])
}

model TenantIntegration {
  id             String              @id @default(uuid())
  tenantId       String
  provider       IntegrationProvider
  encryptedToken String
  capabilities   Json?
  status         String              @default("ACTIVE") // ACTIVE, EXPIRED, FAILED
  lastCheckedAt  DateTime?
  lastError      String?
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// CRM ENUMS
// -----------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  CHURNED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TimelineType {
  NOTE
  EMAIL
  CALL
  SYSTEM
}

enum EntityType {
  LEAD
  CUSTOMER
  TASK
  LOCATION
  CONTACT
  DEAL
  PROJECT
  TICKET
  INCIDENT
}

enum DealStatus {
  OPEN
  WON
  LOST
}

// -----------------------------------------------------------------------------
// COMMUNICATION ENUMS
// -----------------------------------------------------------------------------

enum NotificationType {
  ALERT
  REMINDER
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// -----------------------------------------------------------------------------
// CRM MODELS
// -----------------------------------------------------------------------------

model Lead {
  id             String     @id @default(uuid())
  tenantId       String
  name           String
  company        String
  email          String?
  phone          String?
  status         LeadStatus @default(NEW)
  assignedUserId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  assignedUser User?  @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  tasks        Task[]
  deals        Deal[]

  @@unique([tenantId, email])
  @@unique([tenantId, name, company])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Customer {
  id             String         @id @default(uuid())
  tenantId       String
  name           String
  normalizedName String
  industry       String?
  status         CustomerStatus @default(ACTIVE)
  assignedUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  assignedUser User?             @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  contacts     CustomerContact[]
  locations    Location[]
  tasks        Task[]
  deals        Deal[]
  documents    Document[]

  // Communication

  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@index([tenantId, name])
}

model CustomerContact {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Communication
  meetingParticipants MeetingParticipant[]

  @@index([tenantId, customerId])
}

model Location {
  id          String    @id @default(uuid())
  tenantId    String
  customerId  String
  name        String
  address     String?
  city        String?
  state       String?
  zip         String?
  coordinates String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cameras   Camera[]
  incidents Incident[]

  @@index([tenantId, customerId])
}

model Task {
  id             String       @id @default(uuid())
  tenantId       String
  title          String
  description    String?
  dueDate        DateTime?
  status         TaskStatus   @default(PENDING)
  priority       TaskPriority @default(MEDIUM)
  assignedUserId String?
  leadId         String?
  customerId     String?
  dealId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  assignedUser User?      @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  lead         Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal         Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  documents    Document[]

  @@index([tenantId, assignedUserId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, customerId])
  @@index([tenantId, dueDate])
  @@index([tenantId, priority])
}

model CRMComment {
  id         String     @id @default(uuid())
  tenantId   String
  userId     String
  content    String
  parentId   String?
  entityType EntityType
  entityId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  user    User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent  CRMComment?  @relation("Thread", fields: [parentId], references: [id], onDelete: SetNull)
  replies CRMComment[] @relation("Thread")

  @@index([tenantId, entityType, entityId])
  @@index([parentId])
}

model ActivityTimeline {
  id         String       @id @default(uuid())
  tenantId   String
  type       TimelineType
  content    String
  actorId    String
  entityType EntityType
  entityId   String
  createdAt  DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId])
}

// -----------------------------------------------------------------------------
// COMMUNICATION MODELS
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// VIDEO MEETING MODELS
// -----------------------------------------------------------------------------

model Meeting {
  id           String    @id @default(uuid())
  tenantId     String
  providerId   String?
  status       String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  participants MeetingParticipant[]
  deletedAt    DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, startedAt])
}

model MeetingParticipant {
  id        String    @id @default(uuid())
  tenantId  String
  meetingId String
  userId    String?
  contactId String?
  role      String    @default("ATTENDEE") // HOST, ATTENDEE
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime  @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  meeting Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId, meetingId])
  @@index([tenantId, userId])
}

// -----------------------------------------------------------------------------
// STORAGE MODELS
// -----------------------------------------------------------------------------

model DemoStorage {
  id         String   @id @default(uuid())
  tenantId   String
  fileName   String
  mimeType   String
  base64Data String
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Document {
  id           String   @id @default(uuid())
  tenantId     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String
  customerId   String?
  taskId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, taskId])
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  type      NotificationType
  title     String
  body      String
  actionUrl String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
}

model NotificationPreference {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  inAppEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// -----------------------------------------------------------------------------

// CCTV ENUMS
// -----------------------------------------------------------------------------

enum CameraProtocol {
  RTSP
  ONVIF
}

enum CameraStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum StreamStatus {
  ACTIVE
  INACTIVE
}

enum RecordingStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum CameraEventType {
  CONNECT
  DISCONNECT
  REBOOT
  MOTION
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

// -----------------------------------------------------------------------------
// CCTV MODELS
// -----------------------------------------------------------------------------

model Camera {
  id            String         @id @default(uuid())
  tenantId      String
  locationId    String?
  name          String
  model         String?
  manufacturer  String?
  ipAddress     String
  protocol      CameraProtocol
  status        CameraStatus   @default(OFFLINE)
  lastHeartbeat DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  credential CameraCredential?
  stream     CameraStream?
  recordings Recording[]
  events     CameraEvent[]
  aiEvents   AIEvent[]
  incidents  Incident[]
  deletedAt  DateTime?

  @@index([tenantId, locationId])
  @@index([tenantId, status])
}

model CameraCredential {
  id                String   @id @default(uuid())
  tenantId          String
  cameraId          String   @unique
  encryptedUsername String
  encryptedPassword String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([tenantId, cameraId])
}

model CameraStream {
  id        String       @id @default(uuid())
  tenantId  String
  cameraId  String       @unique
  streamUrl String
  protocol  String
  status    StreamStatus @default(INACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model Recording {
  id         String          @id @default(uuid())
  tenantId   String
  cameraId   String
  storageKey String
  status     RecordingStatus @default(PROCESSING)
  startTime  DateTime
  endTime    DateTime?
  sizeBytes  Int?
  createdAt  DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([tenantId, cameraId, startTime])
  @@index([tenantId, status])
}

model CameraEvent {
  id        String          @id @default(uuid())
  tenantId  String
  cameraId  String
  eventType CameraEventType
  severity  EventSeverity   @default(INFO)
  metadata  Json?
  timestamp DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([tenantId, cameraId, timestamp])
  @@index([tenantId, eventType])
}

model AIEvent {
  id             String   @id @default(uuid())
  tenantId       String
  cameraId       String
  model          String
  confidence     Float
  detectedObject String
  metadata       Json?
  timestamp      DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  camera    Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  incident  Incident?
  deletedAt DateTime?

  @@index([tenantId, cameraId, timestamp])
}

// -----------------------------------------------------------------------------
// NEW COMMUNICATION ENUMS & MODELS
// -----------------------------------------------------------------------------

enum ChatConversationType {
  DIRECT
  GROUP
}

enum ChatParticipantRole {
  ADMIN
  MEMBER
}

enum MailDraftStatus {
  DRAFT
}

enum CallProvider {
  INTERNAL
  EXTERNAL
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  COMPLETED
  MISSED
  FAILED
}

enum UserPresenceStatus {
  ONLINE
  OFFLINE
  AWAY
  BUSY
}

enum AttachmentType {
  CHAT
  MAIL
  CALL
}

model ChatConversation {
  id        String               @id @default(uuid())
  tenantId  String
  type      ChatConversationType
  name      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  deletedAt DateTime?

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([tenantId, createdAt])
}

model ChatParticipant {
  id             String              @id @default(uuid())
  tenantId       String
  conversationId String
  userId         String
  role           ChatParticipantRole @default(MEMBER)
  isMuted        Boolean             @default(false)
  archivedAt     DateTime?
  joinedAt       DateTime            @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId, conversationId])
  @@index([tenantId, userId])
}

model ChatMessage {
  id             String    @id @default(uuid())
  tenantId       String
  conversationId String
  senderId       String?
  content        String
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  editedAt       DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  conversation ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  readReceipts ChatReadReceipt[]

  @@index([tenantId, conversationId, createdAt])
}

model ChatReadReceipt {
  id        String   @id @default(uuid())
  tenantId  String
  messageId String
  userId    String
  readAt    DateTime @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([tenantId, messageId])
}

model MailThread {
  id        String   @id @default(uuid())
  tenantId  String
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  messages MailMessage[]
  drafts   MailDraft[]

  @@index([tenantId, createdAt])
}

model MailRecipient {
  id         String    @id @default(uuid())
  tenantId   String
  messageId  String
  userId     String
  type       String    @default("TO") // TO, CC, BCC
  isRead     Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  message MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, messageId])
  @@index([tenantId, userId])
}

model MailMessage {
  id        String   @id @default(uuid())
  tenantId  String
  threadId  String
  senderId  String
  bodyHtml  String?
  bodyText  String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  thread     MailThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender     User            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  recipients MailRecipient[]

  @@index([tenantId, threadId, createdAt])
}

model MailDraft {
  id        String   @id @default(uuid())
  tenantId  String
  threadId  String?
  senderId  String
  subject   String?
  bodyHtml  String?
  bodyText  String?
  toIds     Json? // Array of userIds
  ccIds     Json?
  bccIds    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  thread MailThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  sender User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([tenantId, senderId])
}

model CommunicationAttachment {
  id             String         @id @default(uuid())
  tenantId       String
  uploaderId     String
  attachedToType AttachmentType
  attachedToId   String
  fileName       String
  fileType       String
  storageUrl     String
  size           Int
  createdAt      DateTime       @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  uploader User   @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([tenantId, attachedToType, attachedToId])
  @@index([tenantId, uploaderId])
}

model CallLog {
  id                 String       @id @default(uuid())
  tenantId           String
  callerEmployeeId   String?
  receiverEmployeeId String?
  provider           CallProvider @default(INTERNAL)
  providerCallId     String?
  duration           Int?
  status             CallStatus
  recordingMetadata  Json?
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, callerEmployeeId])
  @@index([tenantId, receiverEmployeeId])
  @@index([tenantId, createdAt])
}

model UserPresence {
  id         String             @id @default(uuid())
  tenantId   String
  userId     String             @unique
  status     UserPresenceStatus @default(OFFLINE)
  lastSeenAt DateTime           @default(now())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// -----------------------------------------------------------------------------
// WEBHOOK INFRASTRUCTURE
// -----------------------------------------------------------------------------

model WebhookEvent {
  id                String        @id @default(uuid())
  tenantId          String?
  provider          String
  eventId           String
  eventType         String
  payloadHash       String
  signatureVerified Boolean       @default(false)
  status            WebhookStatus @default(PENDING)
  processedAt       DateTime?
  createdAt         DateTime      @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@index([tenantId, createdAt])
}

// -----------------------------------------------------------------------------
// INCIDENT MANAGEMENT
// -----------------------------------------------------------------------------

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Incident {
  id             String           @id @default(uuid())
  tenantId       String
  locationId     String
  cameraId       String
  aiEventId      String           @unique
  title          String
  description    String?
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  assignedUserId String?
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?
  deletedAt      DateTime?

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  camera       Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  aiEvent      AIEvent  @relation(fields: [aiEventId], references: [id], onDelete: Cascade)
  assignedUser User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, severity])
}

// -----------------------------------------------------------------------------
// RECOVERY ENGINE
// -----------------------------------------------------------------------------

enum RecoveryStatus {
  REQUESTED
  VALIDATING
  APPROVED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum RecoverySnapshotStatus {
  ACTIVE
  DELETE_PENDING
  DELETED
}

enum RecoveryMode {
  RECOVERY
  CLONE
  DRY_RUN
}

model RecoveryJob {
  id              String         @id @default(uuid())
  tenantId        String
  requestedBy     String
  status          RecoveryStatus @default(REQUESTED)
  mode            RecoveryMode   @default(RECOVERY)
  startedAt       DateTime?
  completedAt     DateTime?
  checksum        String?
  archiveLocation String?
  snapshotId      String?
  approvedBy      String?
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // We intentionally do not strongly relate this to Tenant to avoid cascade deletion loops,
  // since this job tracks the lifecycle of the tenant itself.

  @@index([tenantId, status])
  @@index([createdAt])
}

model RecoverySnapshot {
  id                   String                 @id @default(uuid())
  tenantId             String
  version              Int                    @default(1)
  schemaVersion        String
  applicationVersion   String?
  prismaVersion        String?
  backupFormatVersion  String?
  encryptionAlgorithm  String?
  encryptionKeyVersion String?
  kmsKeyId             String?
  kmsKeyVersion        String?
  encryptedDEK         String?
  status               RecoverySnapshotStatus @default(ACTIVE)
  checksum             String
  sizeBytes            Int?
  createdAt            DateTime               @default(now())

  @@index([tenantId, createdAt])
}

model RecoveryAuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  jobId     String
  action    String // EXPORT_STARTED, RESTORE_STARTED, ROLLBACK, FAILURE, SUCCESS
  actorId   String
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([tenantId, timestamp])
  @@index([jobId])
}

model RestoreCheckpoint {
  id            String    @id @default(uuid())
  tenantId      String
  recoveryJobId String
  phase         String
  model         String
  chunkIndex    Int
  chunkId       String    @unique
  status        String // PENDING, COMPLETED, FAILED
  attempt       Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  errorMessage  String?
  checksum      String?

  @@unique([recoveryJobId, phase, model, chunkIndex])
  @@index([recoveryJobId, status])
}

// -----------------------------------------------------------------------------
// SALES PIPELINE (PHASE R.14.4)
// -----------------------------------------------------------------------------

model Pipeline {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  stages PipelineStage[]
  deals  Deal[]

  @@index([tenantId])
}

model PipelineStage {
  id           String   @id @default(uuid())
  tenantId     String
  pipelineId   String
  name         String
  order        Int
  probability  Int      @default(0) // 0 to 100
  color        String?
  isClosedWon  Boolean  @default(false)
  isClosedLost Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  pipeline    Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]
  historyFrom DealStageHistory[] @relation("HistoryFromStage")
  historyTo   DealStageHistory[] @relation("HistoryToStage")

  @@index([tenantId, pipelineId])
  @@index([pipelineId, order])
}

model Deal {
  id                String     @id @default(uuid())
  tenantId          String
  title             String
  description       String?
  source            String?
  value             Float      @default(0)
  currency          String     @default("USD")
  probability       Int?
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  status            DealStatus @default(OPEN)
  lostReason        String?
  lostCompetitor    String?
  lostNotes         String?
  lostAt            DateTime?
  version           Int        @default(1)

  pipelineId     String
  stageId        String
  customerId     String?
  leadId         String?
  assignedUserId String
  createdById    String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  pipeline     Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage        PipelineStage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead         Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedUser User               @relation("DealAssignedUser", fields: [assignedUserId], references: [id])
  createdUser  User               @relation("DealCreatedUser", fields: [createdById], references: [id])
  stageHistory DealStageHistory[]
  tasks        Task[]

  @@index([tenantId, status])
  @@index([tenantId, stageId])
  @@index([tenantId, assignedUserId])
}

model DealStageHistory {
  id          String   @id @default(uuid())
  tenantId    String
  dealId      String
  fromStageId String?
  toStageId   String
  changedById String
  createdAt   DateTime @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  deal      Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage PipelineStage? @relation("HistoryFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   PipelineStage  @relation("HistoryToStage", fields: [toStageId], references: [id], onDelete: Cascade)
  changedBy User           @relation(fields: [changedById], references: [id])

  @@index([tenantId, dealId])
  @@index([tenantId, createdAt])
}

model EventOutbox {
  id          String       @id @default(uuid())
  eventId     String       @unique
  tenantId    String
  eventType   String
  payload     Json
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0)
  lastError   String?
  nextRetryAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, nextRetryAt])
  @@index([eventId])
}

// -----------------------------------------------------------------------------
// AI & CRM (PHASE AI)
// -----------------------------------------------------------------------------

enum AIRole {
  USER
  ASSISTANT
}

enum AIConversationStatus {
  ACTIVE
  ARCHIVED
}

model AIConversation {
  id         String               @id @default(uuid())
  tenantId   String
  userId     String
  title      String?
  status     AIConversationStatus @default(ACTIVE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  tenant   Tenant                  @relation(fields: [tenantId], references: [id])
  user     User                    @relation(fields: [userId], references: [id])
  messages AIConversationMessage[]

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, status, archivedAt])
}

model AIConversationMessage {
  id             String   @id @default(uuid())
  conversationId String
  tenantId       String
  role           AIRole
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId, conversationId, createdAt])
}
